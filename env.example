# Supabase Configuration
# Отримайте ці значення з вашого Supabase проекту на https://supabase.com/dashboard
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Приклад:
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Інструкції:
# 1. Скопіюйте цей файл як .env
# 2. Замініть your_supabase_project_url_here на URL вашого Supabase проекту
# 3. Замініть your_supabase_anon_key_here на анонімний ключ вашого проекту
# 4. Перезапустіть додаток



